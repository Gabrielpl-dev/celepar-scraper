# Copiar pra eval-harness/.env (gitignored) e preencher.

# Onde bater -- servidor de produção (só o que existe hoje). Rodar contra localhost só faz
# sentido se algum dia isso for deployado dentro de C:\celepar_app\ mesmo (ver README).
CELEPAR_API_BASE_URL=http://140.238.238.172:3000

# Conta de serviço dedicada (role viewer, só leitura) -- criar com `npm run setup-agent-account`.
CELEPAR_EVAL_USERNAME=AGENTE_EVAL
CELEPAR_EVAL_PASSWORD=

# Intervalo entre rodadas, em minutos.
EVAL_INTERVAL_MIN=10
