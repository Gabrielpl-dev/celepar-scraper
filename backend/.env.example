# Copiar pra backend/.env (gitignored) e preencher os valores reais.
# Nunca commitar backend/.env com valores reais.

PORT=3000

# Gerar com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Oracle REAG (banco institucional) -- connection string completa no cofre de senhas
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=

# Portal Agrofit/Embrapa -- token via client_credentials, só key+secret (Basic auth)
AGROFIT_KEY=
AGROFIT_SECRET=

# Login do usuário de serviço GPL_SCRAPER (routes/auth.js) -- sem isso o login desse
# usuário falha com erro explícito no log ("GPL_SCRAPER_PASSWORD não configurado").
GPL_SCRAPER_PASSWORD=

# Opcional -- CORS. Sem isso, sem restrição de origin em /api.
ALLOWED_ORIGIN=
