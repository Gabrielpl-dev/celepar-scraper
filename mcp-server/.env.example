# Backend do celepar_scraper já deployado — este MCP server nunca fala com
# localhost, ele é um CLIENTE do backend remoto (ver .envs/infra.md).
CELEPAR_API_BASE_URL=http://140.238.238.172:3000

# Conta de serviço dedicada (role "viewer" — suficiente pra todas as tools
# deste servidor, nenhuma delas exige admin). Criar rodando:
#   npm run setup-agent-account
